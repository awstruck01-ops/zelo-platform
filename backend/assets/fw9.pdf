const fs = require('fs');
const path = require('path');
const { PDFDocument } = require('pdf-lib');

const TEMPLATE_PATH = path.join(__dirname, '..', '..', 'assets', 'fw9.pdf');

const CLASSIFICATION_CHECKBOX_INDEX = {
  individual: 0,
  sole_proprietor: 0,
  c_corp: 1,
  s_corp: 2,
  partnership: 3,
  trust_estate: 4,
  llc: 5,
  other: 6,
};

async function prefillW9(submission) {
  const { legal_name, business_name, tax_classification, address, city, state, zip } = submission;

  const templateBytes = fs.readFileSync(TEMPLATE_PATH);
  const pdfDoc = await PDFDocument.load(templateBytes);
  const form = pdfDoc.getForm();

  const setText = (name, value) => {
    try {
      form.getTextField(name).setText(value || '');
    } catch {
      // Field not present in this revision of the form — skip rather than crash.
    }
  };
  const check = (name) => {
    try {
      form.getCheckBox(name).check();
    } catch {
      // ignore
    }
  };

  setText('topmostSubform[0].Page1[0].f1_01[0]', legal_name);
  setText('topmostSubform[0].Page1[0].f1_02[0]', business_name);
  setText('topmostSubform[0].Page1[0].Address_ReadOrder[0].f1_07[0]', address);
  setText('topmostSubform[0].Page1[0].Address_ReadOrder[0].f1_08[0]', `${city}, ${state} ${zip}`);

  const classificationKey = String(tax_classification || '').toLowerCase();
  const boxIndex = CLASSIFICATION_CHECKBOX_INDEX[classificationKey];
  if (boxIndex !== undefined) {
    check(`topmostSubform[0].Page1[0].Boxes3a-b_ReadOrder[0].c1_1[${boxIndex}]`);
  }

  const filledBytes = await pdfDoc.save();
  return Buffer.from(filledBytes);
}

module.exports = { prefillW9 };
