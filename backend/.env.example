# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=zelo
# Use DATABASE_URL instead of the above if your host provides one (Render/Railway/Supabase etc.)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Use REDIS_URL instead if your host provides one
# REDIS_URL=redis://default:password@host:port

# Auth - generate strong random values for these, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-this-with-a-long-random-string
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-string

# Business rules
PLATFORM_COMMISSION_RATE=0.15
PLATFORM_DELIVERY_MARGIN=0.20
DEFAULT_DELIVERY_RADIUS_MI=7.5
DEFAULT_SALES_TAX_RATE=0.08
MIN_DRIVER_AGE_MOTORIZED=18
MIN_DRIVER_AGE_BICYCLE=17

# Delivery fee formula (per mile rate in USD, by vehicle type)
RATE_BICYCLE=0.60
RATE_SCOOTER=0.75
RATE_MOTORCYCLE=0.90
RATE_CAR=1.10
RATE_TRUCK=1.75
BASE_FARE=2.50
